Let word be "(()", and let second word be ")()())".
Let first n be 3.
Let second n be 6.

Let best start at 0.
For every start from 0 to first n - 1:
    For every finish from start to first n - 1:
        Let balance start at 0.
        Let valid be true.
        For every k from start to finish:
            If character k of word is 40:
                Add 1 to balance.
            Otherwise:
                Subtract 1 from balance.
                If balance < 0:
                    Set valid to false.
        If valid and balance is 0:
            Let span be finish - start + 1.
            If span > best:
                Set best to span.
Print best.

Set best to 0.
For every start from 0 to second n - 1:
    For every finish from start to second n - 1:
        Let balance start at 0.
        Let valid be true.
        For every k from start to finish:
            If character k of second word is 40:
                Add 1 to balance.
            Otherwise:
                Subtract 1 from balance.
                If balance < 0:
                    Set valid to false.
        If valid and balance is 0:
            Let span be finish - start + 1.
            If span > best:
                Set best to span.
Print best.
