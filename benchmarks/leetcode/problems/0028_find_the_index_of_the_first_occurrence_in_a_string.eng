Let word be "sadbutsad".
Let needle be "sad".
Let n be the number of characters in word.
Let m be the number of characters in needle.
Let found be false.

For every offset from 0 to n - m:
    If found is false:
        Let matches be true.
        For every j from 0 to m - 1:
            Let position be offset + j.
            If character position of word is not character j of needle:
                Set matches to false.
        If matches is true:
            Set found to true.
            Print offset.

If found is false:
    Print -1.
