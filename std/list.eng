A growable sequence of values of one type.

Use alloc and core.

A public record List of T has a data as a pointer to T, a len as an unsigned number, and a cap as an unsigned number.

Publicly, to list_new for T, returning List of T.
    Define local created as List of T.
    Give back created.
Done.

Publicly, to list_push for T given items as a pointer to List of T, val as T, returning nothing.
    Call this as "push <val> to <items>".
    Call this as "append <val> to <items>".
    If items.len == items.cap:
        Define local new_cap as an unsigned number.
        If items.cap == 0:
            Set new_cap to 8 as an unsigned number.
        Else:
            Set new_cap to items.cap * 2.
        Define local old_bytes as an unsigned number.
        Define local new_bytes as an unsigned number.
        Set old_bytes to items.cap * (byte size of T).
        Set new_bytes to new_cap * (byte size of T).
        Set items.data to heap_realloc(items.data as a pointer to byte, old_bytes, new_bytes) as a pointer to T.
        Set items.cap to new_cap.
    Set item items.len of items.data to val.
    Add 1 to items.len.
Done.

Publicly, to list_pop for T given items as a pointer to List of T, returning T.
    Call this as "pop from <items>".
    If items.len == 0:
        panic("pop from empty list", 19).
    Set items.len to items.len - 1.
    Give back item items.len of items.data.
Done.

Publicly, to list_get for T given items as a pointer to List of T, index as an unsigned number, returning T.
    If index >= items.len:
        panic("list index out of bounds", 24).
    Give back item index of items.data.
Done.

Publicly, to list_set for T given items as a pointer to List of T, index as an unsigned number, val as T, returning nothing.
    If index >= items.len:
        panic("list index out of bounds", 24).
    Set item index of items.data to val.
Done.

Publicly, to list_len for T given items as a pointer to List of T, returning an unsigned number.
    Call this as "count of <items>".
    Give back items.len.
Done.

Publicly, to list_first for T given items as a pointer to List of T, returning T.
    Call this as "first item of <items>".
    If items.len == 0:
        panic("first item of empty list", 24).
    Give back item 0 of items.data.
Done.

Publicly, to list_last for T given items as a pointer to List of T, returning T.
    Call this as "last item of <items>".
    If items.len == 0:
        panic("last item of empty list", 23).
    Give back item (items.len - 1) of items.data.
Done.

Publicly, to list_clear for T given items as a pointer to List of T, returning nothing.
    Set items.len to 0 as an unsigned number.
Done.

Publicly, to list_free for T given items as a pointer to List of T, returning nothing.
    If items.data as an unsigned number != 0:
        heap_free(items.data as a pointer to byte).
    Set items.data to no address.
    Set items.len to 0 as an unsigned number.
    Set items.cap to 0 as an unsigned number.
Done.

Publicly, to list_sort for T given items as a pointer to List of T, compare as a function taking pointer to T and pointer to T returning whole number, returning nothing.
    Define local outer as an unsigned number.
    While outer < items.len:
        Define local inner as an unsigned number.
        Set inner to outer.
        While inner > 0:
            Define local left as a pointer to T.
            Define local right as a pointer to T.
            Set left to address of item (inner - 1) of items.data.
            Set right to address of item inner of items.data.
            If compare(right, left) < 0:
                Define local temporary as T.
                Set temporary to item inner of items.data.
                Set item inner of items.data to item (inner - 1) of items.data.
                Set item (inner - 1) of items.data to temporary.
                Set inner to inner - 1.
            Else:
                break.
        Add 1 to outer.
Done.
