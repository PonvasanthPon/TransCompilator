Import alloc.
Import core.
Import string.

Public struct IntMap of V with keys as ptr<i64> and values as ptr<V> and states as ptr<u8> and cap as u64 and len as u64.
Public struct StrMap of V with keys as ptr<ptr<TcString>> and values as ptr<V> and states as ptr<u8> and cap as u64 and len as u64.

function int_hash taking key as i64 returning u64:
    Define local value as u64.
    value = key as u64.
    value = value bitxor (value shr 33).
    value = value * (11400714819323198485 as u64).
    Return value.

function str_hash taking key as ptr<TcString> returning u64:
    Define local value as u64.
    value = 1469598103934665603 as u64.
    Define local index as u64.
    While index < key.len:
        value = (value bitxor (key.data[index] as u64)) * (1099511628211 as u64).
        index += 1.
    Return value.

function intmap_rehash of V taking table as ptr<IntMap<V>> and new_cap as u64 returning void:
    Define local old_keys as ptr<i64>.
    Define local old_values as ptr<V>.
    Define local old_states as ptr<u8>.
    Define local old_cap as u64.
    old_keys = table.keys.
    old_values = table.values.
    old_states = table.states.
    old_cap = table.cap.
    table.keys = heap_alloc(new_cap * 8) as ptr<i64>.
    table.values = heap_alloc(new_cap * (size of V)) as ptr<V>.
    table.states = heap_alloc(new_cap) as ptr<u8>.
    mem_zero(table.states, new_cap).
    table.cap = new_cap.
    table.len = 0.
    Define local index as u64.
    While index < old_cap:
        If old_states[index] == 1:
            Define local old_value as V.
            old_value = old_values[index].
            intmap_put(table, old_keys[index], old_value).
        index += 1.
    If old_cap > 0:
        heap_free(old_keys as ptr<u8>).
        heap_free(old_values as ptr<u8>).
        heap_free(old_states as ptr<u8>).

Public function intmap_new of V returning IntMap<V>:
    Define local created as IntMap<V>.
    Return created.

Public function intmap_put of V taking table as ptr<IntMap<V>> and key as i64 and val as V returning void:
    If table.cap == 0 or (table.len + 1) * 10 >= table.cap * 7:
        Define local next_cap as u64.
        If table.cap == 0:
            next_cap = 16 as u64.
        Else:
            next_cap = table.cap * 2.
        intmap_rehash(table, next_cap).
    Define local index as u64.
    index = int_hash(key) % table.cap.
    Define local first_deleted as u64.
    first_deleted = table.cap.
    Loop:
        If table.states[index] == 1 and table.keys[index] == key:
            Set table.values[index] to val.
            Return.
        If table.states[index] == 2 and first_deleted == table.cap:
            first_deleted = index.
        If table.states[index] == 0:
            If first_deleted != table.cap:
                index = first_deleted.
            table.states[index] = 1.
            table.keys[index] = key.
            Set table.values[index] to val.
            table.len += 1.
            Return.
        index = (index + 1) % table.cap.

Public function intmap_get of V taking table as ptr<IntMap<V>> and key as i64 returning Option<V>:
    Define local answer as Option<V>.
    If table.cap == 0:
        Return answer.
    Define local index as u64.
    index = int_hash(key) % table.cap.
    Define local probes as u64.
    While probes < table.cap:
        If table.states[index] == 0:
            Return answer.
        If table.states[index] == 1 and table.keys[index] == key:
            Set answer.has_value to true.
            Set answer.value to table.values[index].
            Return answer.
        index = (index + 1) % table.cap.
        probes += 1.
    Return answer.

Public function intmap_contains of V taking table as ptr<IntMap<V>> and key as i64 returning bool:
    If table.cap == 0:
        Return false.
    Define local index as u64.
    index = int_hash(key) % table.cap.
    Define local probes as u64.
    While probes < table.cap:
        If table.states[index] == 0:
            Return false.
        If table.states[index] == 1 and table.keys[index] == key:
            Return true.
        index = (index + 1) % table.cap.
        probes += 1.
    Return false.

Public function intmap_remove of V taking table as ptr<IntMap<V>> and key as i64 returning bool:
    If table.cap == 0:
        Return false.
    Define local index as u64.
    index = int_hash(key) % table.cap.
    Define local probes as u64.
    While probes < table.cap:
        If table.states[index] == 0:
            Return false.
        If table.states[index] == 1 and table.keys[index] == key:
            table.states[index] = 2.
            table.len -= 1.
            Return true.
        index = (index + 1) % table.cap.
        probes += 1.
    Return false.

Public function intmap_len of V taking table as ptr<IntMap<V>> returning u64:
    Return table.len.

Public function intmap_free of V taking table as ptr<IntMap<V>> returning void:
    If table.cap > 0:
        heap_free(table.keys as ptr<u8>).
        heap_free(table.values as ptr<u8>).
        heap_free(table.states as ptr<u8>).
    table.keys = 0 as u64 as ptr<i64>.
    table.values = 0 as u64 as ptr<V>.
    table.states = 0 as u64 as ptr<u8>.
    table.cap = 0.
    table.len = 0.

function strmap_rehash of V taking table as ptr<StrMap<V>> and new_cap as u64 returning void:
    Define local old_keys as ptr<ptr<TcString>>.
    Define local old_values as ptr<V>.
    Define local old_states as ptr<u8>.
    Define local old_cap as u64.
    old_keys = table.keys.
    old_values = table.values.
    old_states = table.states.
    old_cap = table.cap.
    table.keys = heap_alloc(new_cap * 8) as ptr<ptr<TcString>>.
    table.values = heap_alloc(new_cap * (size of V)) as ptr<V>.
    table.states = heap_alloc(new_cap) as ptr<u8>.
    mem_zero(table.states, new_cap).
    table.cap = new_cap.
    table.len = 0.
    Define local index as u64.
    While index < old_cap:
        If old_states[index] == 1:
            Define local old_value as V.
            old_value = old_values[index].
            strmap_put(table, old_keys[index], old_value).
        index += 1.
    If old_cap > 0:
        heap_free(old_keys as ptr<u8>).
        heap_free(old_values as ptr<u8>).
        heap_free(old_states as ptr<u8>).

