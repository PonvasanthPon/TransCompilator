Public function strmap_put of V taking table as ptr<StrMap<V>> and key as ptr<TcString> and val as V returning void:
    If table.cap == 0 or (table.len + 1) * 10 >= table.cap * 7:
        Define local next_cap as u64.
        If table.cap == 0:
            next_cap = 16 as u64.
        Else:
            next_cap = table.cap * 2.
        strmap_rehash(table, next_cap).
