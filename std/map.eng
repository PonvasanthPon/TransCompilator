Publicly, to strmap_put for V given table as a pointer to StrMap of V, key as a pointer to TcString, val as V, returning nothing.
    If table.cap == 0 or (table.len + 1) * 10 >= table.cap * 7:
        Define local next_cap as an unsigned number.
        If table.cap == 0:
            Set next_cap to 16 as an unsigned number.
        Else:
            Set next_cap to table.cap * 2.
        strmap_rehash(table, next_cap).
    Define local index as an unsigned number.
    Set index to str_hash(key) % table.cap.
    Define local first_deleted as an unsigned number.
    Set first_deleted to table.cap.
    Loop:
        If item index of table.states == 1 and str_eq(item index of table.keys, key):
            Set item index of table.values to val.
            Give back.
        If item index of table.states == 2 and first_deleted == table.cap:
            Set first_deleted to index.
        If item index of table.states == 0:
            If first_deleted != table.cap:
                Set index to first_deleted.
            Set item index of table.states to 1.
            Set item index of table.keys to key.
            Set item index of table.values to val.
            Add 1 to table.len.
            Give back.
        Set index to (index + 1) % table.cap.
Done.

