A pair of integer and text hash maps with linear probing.

Use alloc, core, and string.

A public record IntMap of V has keys as a pointer to whole number, values as a pointer to V, states as a pointer to byte, a cap as an unsigned number, and a len as an unsigned number.
A public record StrMap of V has keys as a pointer to pointer to TcString, values as a pointer to V, states as a pointer to byte, a cap as an unsigned number, and a len as an unsigned number.

To int_hash given key as a whole number, returning an unsigned number.
    Define local value as an unsigned number.
    Set value to key as an unsigned number.
    Set value to exclusive or of value and (shift value right by 33).
    Set value to value * 11400714819323198485 as an unsigned number.
    Give back value.
Done.

To str_hash given key as a pointer to TcString, returning an unsigned number.
    Define local value as an unsigned number.
    Set value to 1469598103934665603 as an unsigned number.
    Define local index as an unsigned number.
    While index < key.len:
        Define local byte_value as an unsigned number.
        Set byte_value to (item index of key.data) as an unsigned number.
        Set value to (exclusive or of value and byte_value) * 1099511628211 as an unsigned number.
        Add 1 to index.
    Give back value.
Done.

To intmap_rehash for V given table as a pointer to IntMap of V, new_cap as an unsigned number, returning nothing.
    Define local old_keys as a pointer to whole number.
    Define local old_values as a pointer to V.
    Define local old_states as a pointer to byte.
    Define local old_cap as an unsigned number.
    Set old_keys to table.keys.
    Set old_values to table.values.
    Set old_states to table.states.
    Set old_cap to table.cap.
    Set table.keys to heap_alloc(new_cap * 8) as a pointer to whole number.
    Set table.values to heap_alloc(new_cap * (byte size of V)) as a pointer to V.
    Set table.states to heap_alloc(new_cap) as a pointer to byte.
    mem_zero(table.states, new_cap).
    Set table.cap to new_cap.
    Set table.len to 0 as an unsigned number.
    Define local index as an unsigned number.
    While index < old_cap:
        If item index of old_states == 1:
            Define local old_value as V.
            Set old_value to item index of old_values.
            intmap_put(table, item index of old_keys, old_value).
        Add 1 to index.
    If old_cap > 0:
        heap_free(old_keys as a pointer to byte).
        heap_free(old_values as a pointer to byte).
        heap_free(old_states as a pointer to byte).
Done.

Publicly, to intmap_new for V, returning IntMap of V.
    Define local created as IntMap of V.
    Give back created.
Done.

Publicly, to intmap_put for V given table as a pointer to IntMap of V, key as a whole number, val as V, returning nothing.
    If table.cap == 0 or (table.len + 1) * 10 >= table.cap * 7:
        Define local next_cap as an unsigned number.
        If table.cap == 0:
            Set next_cap to 16 as an unsigned number.
        Else:
            Set next_cap to table.cap * 2.
        intmap_rehash(table, next_cap).
    Define local index as an unsigned number.
    Set index to int_hash(key) % table.cap.
    Define local first_deleted as an unsigned number.
    Set first_deleted to table.cap.
    Loop:
        If item index of table.states == 1 and item index of table.keys == key:
            Set item index of table.values to val.
            Give back.
        If item index of table.states == 2 and first_deleted == table.cap:
            Set first_deleted to index.
        If item index of table.states == 0:
            If first_deleted != table.cap:
                Set index to first_deleted.
            Set item index of table.states to 1.
            Set item index of table.keys to key.
            Set item index of table.values to val.
            Add 1 to table.len.
            Give back.
        Set index to (index + 1) % table.cap.
Done.

Publicly, to intmap_get for V given table as a pointer to IntMap of V, key as a whole number, returning Option of V.
    Define local answer as Option of V.
    If table.cap == 0:
        Give back answer.
    Define local index as an unsigned number.
    Set index to int_hash(key) % table.cap.
    Define local probes as an unsigned number.
    While probes < table.cap:
        If item index of table.states == 0:
            Give back answer.
        If item index of table.states == 1 and item index of table.keys == key:
            Set answer.has_value to true.
            Set answer.value to item index of table.values.
            Give back answer.
        Set index to (index + 1) % table.cap.
        Add 1 to probes.
    Give back answer.
Done.

Publicly, to intmap_contains for V given table as a pointer to IntMap of V, key as a whole number, returning a truth value.
    If table.cap == 0:
        Give back false.
    Define local index as an unsigned number.
    Set index to int_hash(key) % table.cap.
    Define local probes as an unsigned number.
    While probes < table.cap:
        If item index of table.states == 0:
            Give back false.
        If item index of table.states == 1 and item index of table.keys == key:
            Give back true.
        Set index to (index + 1) % table.cap.
        Add 1 to probes.
    Give back false.
Done.

Publicly, to intmap_remove for V given table as a pointer to IntMap of V, key as a whole number, returning a truth value.
    If table.cap == 0:
        Give back false.
    Define local index as an unsigned number.
    Set index to int_hash(key) % table.cap.
    Define local probes as an unsigned number.
    While probes < table.cap:
        If item index of table.states == 0:
            Give back false.
        If item index of table.states == 1 and item index of table.keys == key:
            Set item index of table.states to 2.
            Set table.len to table.len - 1.
            Give back true.
        Set index to (index + 1) % table.cap.
        Add 1 to probes.
    Give back false.
Done.

Publicly, to intmap_len for V given table as a pointer to IntMap of V, returning an unsigned number.
    Give back table.len.
Done.

Publicly, to intmap_free for V given table as a pointer to IntMap of V, returning nothing.
    If table.cap > 0:
        heap_free(table.keys as a pointer to byte).
        heap_free(table.values as a pointer to byte).
        heap_free(table.states as a pointer to byte).
    Set table.keys to 0 as an unsigned number as a pointer to whole number.
    Set table.values to no address as a pointer to V.
    Set table.states to no address as a pointer to byte.
    Set table.cap to 0 as an unsigned number.
    Set table.len to 0 as an unsigned number.
Done.

To strmap_rehash for V given table as a pointer to StrMap of V, new_cap as an unsigned number, returning nothing.
    Define local old_keys as a pointer to pointer to TcString.
    Define local old_values as a pointer to V.
    Define local old_states as a pointer to byte.
    Define local old_cap as an unsigned number.
    Set old_keys to table.keys.
    Set old_values to table.values.
    Set old_states to table.states.
    Set old_cap to table.cap.
    Set table.keys to heap_alloc(new_cap * 8) as a pointer to pointer to TcString.
    Set table.values to heap_alloc(new_cap * (byte size of V)) as a pointer to V.
    Set table.states to heap_alloc(new_cap) as a pointer to byte.
    mem_zero(table.states, new_cap).
    Set table.cap to new_cap.
    Set table.len to 0 as an unsigned number.
    Define local index as an unsigned number.
    While index < old_cap:
        If item index of old_states == 1:
            Define local old_value as V.
            Set old_value to item index of old_values.
            strmap_put(table, item index of old_keys, old_value).
        Add 1 to index.
    If old_cap > 0:
        heap_free(old_keys as a pointer to byte).
