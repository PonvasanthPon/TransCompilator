Import core.

Define struct AllocHeader with size as u64 and is_free as u64 and next as ptr<AllocHeader> and pad as u64.

Define global alloc_head as ptr<AllocHeader>.
Define global alloc_bytes_in_use as u64.
Define global alloc_free_count as u64.

function align16 taking n as u64 returning u64:
    Return (n + 15) bitand (bitnot (15 as u64)).

function align_page taking n as u64 returning u64:
    Return (n + 4095) bitand (bitnot (4095 as u64)).

function header_of taking p as ptr<u8> returning ptr<AllocHeader>:
    Return (p as u64 - 32) as ptr<AllocHeader>.

function payload_of taking h as ptr<AllocHeader> returning ptr<u8>:
    Return (h as u64 + 32) as ptr<u8>.

function smaller taking a as u64 and b as u64 returning u64:
    If a < b:
        Return a.
    Return b.

Public function heap_alloc taking size as u64 returning ptr<u8>:
    Define local need as u64.
    need = align16(size).
    If need < 16:
        need = 16 as u64.
    Define local block as ptr<AllocHeader>.
    block = alloc_head.
    While block as u64 != 0:
        If block.is_free == 1 and block.size >= need:
            If block.size >= need + 64:
                Define local rest as ptr<AllocHeader>.
                rest = (block as u64 + 32 + need) as ptr<AllocHeader>.
                Set rest.size to block.size - need - 32.
                Set rest.is_free to 1.
                Set rest.next to block.next.
                Set block.size to need.
                Set block.next to rest.
                alloc_bytes_in_use += need.
            Else:
                alloc_bytes_in_use += block.size.
            Set block.is_free to 0.
            Return payload_of(block).
        block = block.next.
    Define local chunk as u64.
    If need > 65504:
        chunk = align_page(need + 32).
    Else:
        chunk = 65536 as u64.
    Define local raw as i64.
    raw = syscall(9, 0, chunk, 3, 34, -1, 0).
    If raw < 0:
        panic(bytes_ptr("out of memory"), bytes_len("out of memory")).
    Define local fresh as ptr<AllocHeader>.
    fresh = raw as u64 as ptr<AllocHeader>.
    Set fresh.size to chunk - 32.
    Set fresh.is_free to 0.
    Set fresh.next to alloc_head.
    alloc_head = fresh.
    If fresh.size >= need + 64:
        Define local rest as ptr<AllocHeader>.
        rest = (fresh as u64 + 32 + need) as ptr<AllocHeader>.
        Set rest.size to fresh.size - need - 32.
        Set rest.is_free to 1.
        Set rest.next to fresh.next.
        Set fresh.size to need.
        Set fresh.next to rest.
        alloc_bytes_in_use += need.
    Else:
        alloc_bytes_in_use += fresh.size.
    Return payload_of(fresh).

Public function heap_free taking p as ptr<u8> returning void:
    If p as u64 == 0:
        Return.
    Define local h as ptr<AllocHeader>.
    h = header_of(p).
    If h.is_free == 1:
        Return.
    Set h.is_free to 1.
    alloc_bytes_in_use -= h.size.
    alloc_free_count += 1.
    Define local following as ptr<AllocHeader>.
    following = h.next.
    If following as u64 != 0 and following.is_free == 1 and (h as u64 + 32 + h.size) == (following as u64):
        Set h.size to h.size + 32 + following.size.
        Set h.next to following.next.

Public function heap_realloc taking p as ptr<u8> and old_size as u64 and new_size as u64 returning ptr<u8>:
    If p as u64 == 0:
        Return heap_alloc(new_size).
    Define local h as ptr<AllocHeader>.
    h = header_of(p).
    If new_size <= h.size:
        Return p.
    Define local replacement as ptr<u8>.
    replacement = heap_alloc(new_size).
    Define local copy_len as u64.
    copy_len = smaller(old_size, new_size).
    Copy copy_len bytes from p to replacement.
    heap_free(p).
    Return replacement.

Public function heap_bytes_in_use returning u64:
    Return alloc_bytes_in_use.

Public function heap_free_count returning u64:
    Return alloc_free_count.
