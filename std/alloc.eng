A dynamic memory allocator with reusable blocks over Linux pages.

Use core.

A record AllocHeader has a size as an unsigned number, an is_free flag as an unsigned number, a next link as a pointer to AllocHeader, and a pad as an unsigned number.

Keep a shared alloc_head as a pointer to AllocHeader.
Keep a shared alloc_bytes_in_use as an unsigned number.
Keep a shared alloc_free_count as an unsigned number.

To align16 given n as an unsigned number, returning an unsigned number.
    Add 15 to n.
    Clear bits 15 from n.
    Give back n.
Done.

To align_page given n as an unsigned number, returning an unsigned number.
    Add 4095 to n.
    Clear bits 4095 from n.
    Give back n.
Done.

To header_of given p as a pointer to byte, returning a pointer to AllocHeader.
    Give back (p as an unsigned number - 32) as a pointer to AllocHeader.
Done.

To payload_of given h as a pointer to AllocHeader, returning a pointer to byte.
    Give back (h as an unsigned number + 32) as a pointer to byte.
Done.

To smaller given a as an unsigned number, b as an unsigned number, returning an unsigned number.
    If a < b:
        Give back a.
    Give back b.
Done.

Publicly, to heap_alloc given size as an unsigned number, returning a pointer to byte.
    Define local need as an unsigned number.
    Set need to align16(size).
    If need < 16:
        Set need to 16 as an unsigned number.
    Define local block as a pointer to AllocHeader.
    Set block to alloc_head.
    While block as an unsigned number != 0:
        If block.is_free == 1 and block.size >= need:
            If block.size >= need + 64:
                Define local rest as a pointer to AllocHeader.
                Set rest to (block as an unsigned number + 32 + need) as a pointer to AllocHeader.
                Set rest.size to block.size - need - 32.
                Set rest.is_free to 1.
                Set rest.next to block.next.
                Set block.size to need.
                Set block.next to rest.
                Add need to alloc_bytes_in_use.
            Else:
                Add block.size to alloc_bytes_in_use.
            Set block.is_free to 0.
            Give back payload_of(block).
        Set block to block.next.
    Define local chunk as an unsigned number.
    If need > 65504:
        Set chunk to align_page(need + 32).
    Else:
        Set chunk to 65536 as an unsigned number.
    Define local raw as a whole number.
    Set raw to ask Linux kernel 9 with 0, chunk, 3, 34, -1, and 0.
    If raw < 0:
        panic("out of memory", 13).
    Define local fresh as a pointer to AllocHeader.
    Set fresh to raw as an unsigned number as a pointer to AllocHeader.
    Set fresh.size to chunk - 32.
    Set fresh.is_free to 0.
    Set fresh.next to alloc_head.
    Set alloc_head to fresh.
    If fresh.size >= need + 64:
        Define local rest as a pointer to AllocHeader.
        Set rest to (fresh as an unsigned number + 32 + need) as a pointer to AllocHeader.
        Set rest.size to fresh.size - need - 32.
        Set rest.is_free to 1.
        Set rest.next to fresh.next.
        Set fresh.size to need.
        Set fresh.next to rest.
        Add need to alloc_bytes_in_use.
    Else:
        Add fresh.size to alloc_bytes_in_use.
    Give back payload_of(fresh).
Done.

Publicly, to heap_free given p as a pointer to byte, returning nothing.
    If p as an unsigned number == 0:
        Give back.
    Define local h as a pointer to AllocHeader.
    Set h to header_of(p).
    If h.is_free == 1:
        Give back.
    Set h.is_free to 1.
    Set alloc_bytes_in_use to alloc_bytes_in_use - h.size.
    Add 1 to alloc_free_count.
    Define local following as a pointer to AllocHeader.
    Set following to h.next.
    If following as an unsigned number != 0 and following.is_free == 1 and (h as an unsigned number + 32 + h.size) == (following as an unsigned number):
        Set h.size to h.size + 32 + following.size.
        Set h.next to following.next.
Done.

Publicly, to heap_realloc given p as a pointer to byte, old_size as an unsigned number, new_size as an unsigned number, returning a pointer to byte.
    If p as an unsigned number == 0:
        Give back heap_alloc(new_size).
    Define local h as a pointer to AllocHeader.
    Set h to header_of(p).
    If new_size <= h.size:
        Give back p.
    Define local replacement as a pointer to byte.
    Set replacement to heap_alloc(new_size).
    Define local copy_len as an unsigned number.
    Set copy_len to smaller(old_size, new_size).
    Copy copy_len bytes from p to replacement.
    heap_free(p).
    Give back replacement.
Done.

Publicly, to heap_bytes_in_use returning an unsigned number.
    Give back alloc_bytes_in_use.
Done.

Publicly, to heap_free_count returning an unsigned number.
    Give back alloc_free_count.
Done.
